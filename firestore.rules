rules_version = '2';

// Wan & Co. — Firestore セキュリティルール
// Firebase コンソール → Firestore Database → ルール に貼り付けて「公開」してください。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // 施設
    match /places/{place} {
      // 公開スポットは誰でも閲覧可。非公開は所有者のみ。
      allow read: if resource.data.visibility == 'public'
                  || (signedIn() && resource.data.ownerId == request.auth.uid);

      // 作成はログインユーザー。自分を所有者として登録する場合のみ。
      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid;

      // 更新は「所有者による編集」または「集計フィールドだけの更新（他人のチェックイン/口コミ/同伴報告の反映）」を許可
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['checkinCount','reviewCount','ratingSum','indoorYes','indoorNo'])
      );

      // 削除は所有者のみ
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // 口コミ（誰でも閲覧・ログインユーザーが投稿・投稿者本人が削除）
      match /reviews/{r} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      }

      // 写真（誰でも閲覧・ログインユーザーが追加／削除）
      match /photos/{p} {
        allow read: if true;
        allow create: if signedIn();
        allow delete: if signedIn();
      }

      // チェックイン（誰でも閲覧・本人のみ作成。ID = userId_YYYY-MM-DD で1日1回）
      match /checkins/{c} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      }

      // 店内同伴の報告（1人1票・ID = userId。本人のみ登録／変更／取消）
      match /dogReports/{uid} {
        allow read: if true;
        allow create, update, delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // ユーザー集計（本人のみ読み書き）
    match /users/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email in ['tomi119000@gmail.com'];
    }

    // メタ情報（シード投入マーカー等）。Google施設インデックスは管理者のみ更新可
    match /meta/{doc} {
      allow read: if true;
      allow write: if signedIn() && (doc != 'googlePlaces' || isAdmin());
    }

    // Google API の月間利用回数（予算ガード）。カウンタは増やす方向のみ許可
    match /usage/{month} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn()
        && request.resource.data.get('textPro', 0)      >= resource.data.get('textPro', 0)
        && request.resource.data.get('textEnt', 0)      >= resource.data.get('textEnt', 0)
        && request.resource.data.get('detailsPro', 0)   >= resource.data.get('detailsPro', 0)
        && request.resource.data.get('detailsAtmos', 0) >= resource.data.get('detailsAtmos', 0)
        && request.resource.data.get('photo', 0)        >= resource.data.get('photo', 0);
    }
  }
}
